{
  "name": "gameplay-stream-automation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "jotai": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tampermonkey": "^5.5.0",
    "@vitejs/devtools": "^0.8.2",
    "@vitejs/devtools-oxc": "^0.8.2",
    "@vitejs/devtools-rolldown": "^0.8.2",
    "@vitejs/devtools-vite": "^0.8.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "^5.1.0",
    "daisyui": "^5.8.0",
    "fake-indexeddb": "^6.2.8",
    "oxc-transform-react": "^0.158.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "rolldown": "~1.3.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "4.161.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "error"
    }
  }
}
